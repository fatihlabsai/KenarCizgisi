{
  "name": "kenarcizgisi",
  "productName": "KenarCizgisi",
  "version": "0.4.0",
  "description": "Piksel sanatlı futbol menajerliği oyunu",
  "author": "fatihlabsai",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.fatihlabsai.kenarcizgisi",
    "productName": "KenarCizgisi",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "fonts/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kenar Çizgisi"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fatihlabsai",
        "repo": "KenarCizgisi_surumler",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "build/release-notes.md"
    }
  },
  "devDependencies": {
    "@fontsource/jersey-10": "5.3.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
